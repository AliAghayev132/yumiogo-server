# ============ SERVER ============
# development (default) | production
NODE_ENV=development
# nginx proxies https://yumiogo.com -> http://127.0.0.1:3042
PORT=3042

# ============ DATABASE ============
MONGODB_URI=mongodb://127.0.0.1:27017/yumio
DB_HOST=localhost
DB_NAME=yumio
DB_USERNAME=
DB_PASSWORD=
DB_CLUSTER_NAME=

# ============ AUTH SECRETS ============
# REQUIRED in production — generate each with: openssl rand -hex 32
ACCESS_SECRET_KEY=
REFRESH_SECRET_KEY=
ENCRYPTION_KEY=

# ============ URLS / DOMAIN ============
# Defaults to yumiogo.com in production, localhost in development.
DOMAIN=yumiogo.com
APP_URL=https://yumiogo.com
CLIENT_URL=https://yumiogo.com

# Path to the built client served by this server (single proxy port).
# Defaults to ../admin-web/dist
CLIENT_DIST=

# ============ SMTP (leave blank to log OTP codes to the console) ============
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# ============ DEFAULT ADMIN (created on first boot) ============
DEFAULT_ADMIN_EMAIL=admin@yumio.app
DEFAULT_ADMIN_PASSWORD=Admin123!
