# ============ SERVER ============
NODE_ENV=development
PORT=5000

# ============ DATABASE ============
# Either provide a full connection string via MONGODB_URI...
MONGODB_URI=mongodb://localhost:27017/starter
# ...or the individual pieces below (used as a fallback DB name)
DB_HOST=localhost
DB_NAME=starter
DB_USERNAME=
DB_PASSWORD=
DB_CLUSTER_NAME=

# ============ AUTH SECRETS (use strong random values in production) ============
ACCESS_SECRET_KEY=change_me_access_secret_min_32_chars
REFRESH_SECRET_KEY=change_me_refresh_secret_min_32_chars
ENCRYPTION_KEY=change_me_32_character_encryption_key

# ============ URLS / DOMAIN ============
DOMAIN=localhost
APP_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173

# ============ SMTP (email delivery) ============
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# ============ DEFAULT ADMIN (created on first boot) ============
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=Admin123!
