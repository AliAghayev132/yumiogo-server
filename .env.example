# ============ SERVER ============
# development (default) | production
NODE_ENV=development
# nginx proxies https://yumiogo.com -> http://127.0.0.1:3042
PORT=3042

# ============ DATABASE ============
MONGODB_URI=mongodb://127.0.0.1:27017/yumio
DB_HOST=localhost
DB_NAME=yumio
DB_USERNAME=
DB_PASSWORD=
DB_CLUSTER_NAME=

# ============ AUTH SECRETS ============
# REQUIRED in production — generate each with: openssl rand -hex 32
ACCESS_SECRET_KEY=
REFRESH_SECRET_KEY=
ENCRYPTION_KEY=
# Optional: signs password-reset tokens (default: derived from ENCRYPTION_KEY).
RESET_SECRET_KEY=

# ============ URLS / DOMAIN ============
# Defaults to yumiogo.com in production, localhost in development.
DOMAIN=yumiogo.com
APP_URL=https://yumiogo.com
CLIENT_URL=https://yumiogo.com
# Origin of the share links and their landing pages (/list, /restaurant, /invite, /review).
# Defaults to APP_URL.
WEB_URL=https://yumiogo.com

# Path to the built client served by this server (single proxy port).
# Defaults to ../admin-web/dist
CLIENT_DIST=

# ============ SMTP (leave blank to log OTP codes to the console) ============
# Production without SMTP answers sign-up / password-reset with 503 MAIL_NOT_CONFIGURED
# (GET /api/health reports "mail"). Use a transactional provider (SES, Postmark, Mailgun…)
# with a yumiogo.com sender (SPF / DKIM / DMARC).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
# true = refuse to start in production without SMTP_USER / SMTP_PASS.
REQUIRE_SMTP=false

# ============ DEFAULT ADMIN (created on first boot) ============
DEFAULT_ADMIN_EMAIL=admin@yumio.app
# REQUIRED in production (a strong password; the development fallback is refused there).
# Change it after the first sign-in. Never commit the real value.
DEFAULT_ADMIN_PASSWORD=

# ============ DEMO DATA ============
# Allow the admin panel "Load mock data" / "Delete demo data" actions (and `npm run seed`)
# in production. Always allowed when NODE_ENV is not production.
ENABLE_DEMO_SEED=false
# Allow the admin panel "Delete all data" danger-zone action (POST /api/admin/data/wipe) in
# production. It deletes every non-admin account, all restaurants, reviews, lists,
# notifications, reports and uploaded files (admins, catalog and settings are kept unless
# "Also reset catalog & settings" is ticked). Cannot be undone. Always allowed outside production.
ENABLE_DATA_WIPE=false

# ============ APP LINKS (share links open the installed app) ============
# Served as /.well-known/apple-app-site-association and /.well-known/assetlinks.json
# for /list/*, /restaurant/*, /invite/*, /review/* (404 until set).
# Apple Developer team id (10 characters) + iOS bundle id (mobile/app.json → ios.bundleIdentifier).
APPLE_TEAM_ID=
IOS_BUNDLE_ID=com.aliaghayev.yumio
# Android package (mobile/app.json → android.package) + SHA-256 signing-cert fingerprints,
# comma-separated "AB:CD:…": the RELEASE upload key (keystore from YUMIO_UPLOAD_* in
# ~/.gradle/gradle.properties, see mobile/README.md → `keytool -list -v -keystore <file>`),
# plus the Play App Signing key from Play Console if the app is distributed through Play.
ANDROID_PACKAGE=com.aliaghayev.yumio
ANDROID_CERT_SHA256=

# ============ GOOGLE SIGN-IN ============
# Comma-separated OAuth client ids (web, iOS, Android). Empty = "Continue with Google" is disabled (501).
GOOGLE_CLIENT_IDS=
